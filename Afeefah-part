# --- Linked List Implementation ---
class MessageNode:
    """Node for linked list message storage"""
    def __init__(self, data):
        self.data = data
        self.next = None

class MessageLinkedList:
    """Linked list for message history"""
    def __init__(self):
        self.head = None
        self.tail = None
        self.size = 0
    
    def append(self, data):
        """Add a new message to the end of the linked list"""
        new_node = MessageNode(data)
        if self.head is None:
            self.head = new_node
            self.tail = new_node
        else:
            self.tail.next = new_node
            self.tail = new_node
        self.size += 1
    
    def to_list(self):
        """Convert linked list to regular list"""
        result = []
        current = self.head
        while current:
            result.append(current.data)
            current = current.next
        return result
    
    def clear(self):
        """Clear the linked list"""
        self.head = None
        self.tail = None
        self.size = 0

# Initialize the linked list for message history
